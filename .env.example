# ---- Data backend -------------------------------------------------------
# "demo" (default) uses in-memory demonstration data. "supabase" uses the
# adapter in src/lib/data/supabase-repository.ts (schema in supabase/migrations).
DATA_BACKEND=demo
NEXT_PUBLIC_DEMO_MODE=true

# ---- Supabase (server-side only; never expose the service role key) ------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Admin access ---------------------------------------------------------
# Placeholder gate for the admin dashboard until Supabase Auth + roles is wired.
# Generate with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Tree-planting partner -----------------------------------------------
# Leave blank until a partnership is confirmed. Shown publicly when set.
TREE_PARTNER_NAME=
TREE_PARTNER_API_URL=
TREE_PARTNER_API_KEY=

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
